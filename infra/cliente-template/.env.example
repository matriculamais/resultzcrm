# =============================================================
# Template de variaveis por cliente (uma copia por instancia)
# Preencha no painel do Coolify em Environment Variables.
# =============================================================

# --- Imagem ---
# Fase 1 (Twenty padrao): deixe como esta.
# Fase 2 (fork customizado): troque para ghcr.io/lucasddmoraes/resultzcrm
TWENTY_IMAGE=twentycrm/twenty
TAG=latest

# --- URL publica do cliente ---
SERVER_URL=https://cliente.resultz.com.br

# --- Banco de dados (interno ao compose, nunca exposto) ---
PG_DATABASE_USER=postgres
PG_DATABASE_NAME=default
# Senha forte SEM caracteres especiais (gere no 1Password/Bitwarden)
PG_DATABASE_PASSWORD=

# --- Seguranca ---
# Gere uma string aleatoria de 32+ caracteres, unica por cliente.
# NUNCA troque depois de criada (criptografa dados no banco).
ENCRYPTION_KEY=

# --- Cloudflare Tunnel (ingresso, um tunnel por cliente) ---
# Painel Cloudflare > Zero Trust > Networks > Tunnels > Create > Docker
CLOUDFLARE_TUNNEL_TOKEN=

# --- Arquivos anexos em Cloudflare R2 (S3 compativel) ---
# STORAGE_TYPE=local usa disco do VPS; s3 usa o R2.
STORAGE_TYPE=s3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=nome-do-bucket-do-cliente
# Endpoint da conta R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- E-mail transacional (convites, redefinicao de senha) ---
# Recomendado: Resend (resend.com) ou Brevo (brevo.com), plano gratuito.
EMAIL_FROM_ADDRESS=crm@resultz.com.br
EMAIL_FROM_NAME=Resultz CRM
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=

# --- Captcha no login via Cloudflare Turnstile (opcional) ---
# Painel Cloudflare > Turnstile > Add site
CAPTCHA_DRIVER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Bloqueia criacao de novos workspaces por estranhos ---
# Ative (true) depois de criar o workspace do cliente.
IS_SIGN_UP_DISABLED=false

# --- Backup diario do banco para R2 ---
# Para ativar, defina COMPOSE_PROFILES=backup e preencha abaixo.
COMPOSE_PROFILES=
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=cliente
